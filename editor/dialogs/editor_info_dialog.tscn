bbcode_text = "[center]
[b]Space[/b] - Play audio
[b]Shift + Space[/b] - Play and follow the track
[b]Mouse Left Click[/b] - Add note
[b]Mouse Right Click[/b] - Remove note
[b]Shift + Mouse Left Press[/b] - Move note
[b]Shift + Alt + Mouse Left Press[/b] - Move note without snapping to grid
[b]NumPad (-)  / Q[/b] - Scale down
[b]NumPad (+)  / W[/b] - Scale up
[b]Control + S[/b] - Save map
[b]Shift + Mouse Scroll[/b] - Horizontal scroll (ignores vertical scroll)
[/center]"
text = "
Space - Play audio
Shift + Space - Play and follow the track
Mouse Left Click - Add note
Mouse Right Click - Remove note
Shift + Mouse Left Press - Move note
Shift + Alt + Mouse Left Press - Move note without snapping to grid
NumPad (-)  / Q - Scale down
NumPad (+)  / W - Scale up
Control + S - Save map
Shift + Mouse Scroll - Horizontal scroll (ignores vertical scroll)
"

